# LLM API Configuration
# Copy this file to .env and fill in your API keys

# OpenAI API Key (for GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Alternative: Anthropic Claude API Key
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Alternative: Google Gemini API Key
# GOOGLE_API_KEY=your_google_api_key_here

# LLM Provider Selection (openai, anthropic, google)
LLM_PROVIDER=openai

# LLM Model Selection
# For OpenAI: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo
# For Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229
# For Google: gemini-pro
LLM_MODEL=gpt-4

# Conversational agent model (optional; falls back to LLM_MODEL)
# AGENT_MODEL=gpt-4o-mini

# Temperature for LLM (0.0 to 2.0, lower = more deterministic)
LLM_TEMPERATURE=0.7
