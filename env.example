# PlanC LLM configuration
#
# 1. Copy this file to `.env`:
#      cp env.example .env
# 2. Choose ONE provider block below and fill in its values.
# 3. Never commit `.env` or share a real API key.
# 4. Restart PlanC after changing `.env`.


# -----------------------------------------------------------------------------
# Option A: OpenAI official API (enabled by default)
# -----------------------------------------------------------------------------
# Create a key at https://platform.openai.com/api-keys.
# Leave OPENAI_BASE_URL empty when calling OpenAI directly.

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Use model IDs available to your OpenAI API project.
LLM_MODEL=gpt-4o-mini
AGENT_MODEL=gpt-4o-mini

# Web API settings
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
PLANC_DATABASE=data/planner.db


# -----------------------------------------------------------------------------
# Option B: AIHubMix (alternative; do not enable together with Option A)
# -----------------------------------------------------------------------------
# To use AIHubMix:
#   1. Comment out the five active lines in Option A.
#   2. Uncomment every line in this block.
#   3. Paste an AIHubMix key into AIHUBMIX_API_KEY.
#   4. Replace the model IDs with IDs shown in the AIHubMix model marketplace.
#
# OPENAI_BASE_URL is required in AIHubMix mode. PlanC refuses to start without it
# so the proxy key cannot be sent to the OpenAI endpoint by mistake.

# LLM_PROVIDER=aihubmix
# AIHUBMIX_API_KEY=
# OPENAI_BASE_URL=https://aihubmix.com/v1
# LLM_MODEL=deepseek-v4-flash-0731
# AGENT_MODEL=deepseek-v4-flash-0731


# Generation temperature used by the POI recommender.
LLM_TEMPERATURE=0.7


# -----------------------------------------------------------------------------
# Other providers (parameterized planner only)
# -----------------------------------------------------------------------------
# The POI recommender also contains optional Anthropic and Google integrations,
# but the AI-native `scripts/travel_agent.py` dialogue interpreter currently uses
# an OpenAI-compatible Responses API. These keys alone therefore do not enable
# the conversational entry point.

# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
